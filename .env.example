# RS Refurbished Laptops & Services Environment Configuration Template
# Copy this file to .env and fill in your values. Do NOT commit real API keys or passcodes here.

PORT=5000

# Google Gemini LLM API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_MODEL=gemini-1.5-flash

# Store Owner Admin Passcode (Must be changed in production)
ADMIN_PASSCODE=your_secure_admin_passcode_here

# Cryptographic Token Signing Secret (32+ random characters)
ADMIN_JWT_SECRET=your_random_jwt_secret_here
